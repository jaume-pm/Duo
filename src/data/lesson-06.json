    {
      "id": "guo-exp",
      "title": "Verb + 过",
      "structure": "verb + 过 (+ object)",
      "summary": "过 after a verb marks a past experience. Negate with 没(有) before the verb. Don’t use 了 with this 过.",
      "exampleHanzi": "你去过泰国吗？",
      "examplePinyin": "Nǐ qùguo Tàiguó ma?",
      "exampleEn": "Have you been to Thailand?",
      "exercises": {
        "fill": [
          {
