            "prompt": "Have you been to Thailand?",
            "template": "你去____泰国吗？",
            "pinyin": "Nǐ qù ____ Tàiguó ma?",
            "answers": [
              "过",
              "guo"
            ],
            "tip": "Verb + 过 = have ever done. Negative: 没 + verb + 过."
          },
          {
